{
  "name": "hex-calculator",
  "version": "1.0.0",
  "description": "A repository containing instructions on creating a calculator app from start to finish using TDD",
  "main": "index.js",
  "scripts": {
    "test": "jest --verbose",
    "test:unit": "jest calculator.test.js --verbose",
    "test:gui": "jest calculator.gui.test.js --verbose",
    "test:coverage": "jest --coverage",
    "start": "http-server . -p 8080"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicohaasHerhaasus/hex-calculator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NicohaasHerhaasus/hex-calculator/issues"
  },
  "homepage": "https://github.com/NicohaasHerhaasus/hex-calculator#readme",
  "dependencies": {
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testMatch": ["**/calculator.test.js"],
        "testEnvironment": "node"
      },
      {
        "displayName": "gui",
        "testMatch": ["**/calculator.gui.test.js"],
        "testEnvironment": "jsdom"
      }
    ]
  }
}